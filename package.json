{
  "name": "auth-x",
  "version": "1.0.0",
  "type": "module",
  "description": "TOTP two-factor authentication for Node: enrollment, verification, secret encryption and recovery codes",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "tsx examples/demo.ts",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "Iraianbu",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iraianbuuu/auth-x.git"
  }
}
