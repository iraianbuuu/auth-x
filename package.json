{
  "name": "auth-x",
  "version": "0.2.0",
  "type": "module",
  "description": "TOTP two-factor authentication for Node: enrollment, verification, secret encryption and recovery codes",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 \"tests/**/*.test.ts\"",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "tsx examples/demo.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "totp",
    "2fa",
    "two-factor",
    "mfa",
    "otp",
    "rfc6238",
    "authenticator",
    "recovery-codes"
  ],
  "author": "Iraianbu",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iraianbuuu/auth-x.git"
  },
  "homepage": "https://github.com/iraianbuuu/auth-x#readme",
  "bugs": {
    "url": "https://github.com/iraianbuuu/auth-x/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
